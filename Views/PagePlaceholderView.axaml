<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SiagaApi.Views.Components"
    xmlns:vm="using:SiagaApi.ViewModels"
    x:Class="SiagaApi.Views.PagePlaceholderView"
    x:DataType="vm:PagePlaceholderViewModel"
    Background="{StaticResource Latar}">

    <!-- Hanya tampil bila ada nama halaman yang belum punya tampilan sendiri -->
    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">
            <components:BilahAtasView Grid.Row="0"
                                      Judul="{Binding PageTitle}"/>
            <TextBlock Grid.Row="1"
                       Text="Halaman ini belum tersedia."
                       Classes="redup"
                       FontSize="14"
                       Margin="28,24"/>
        </Grid>

    </Grid>
</UserControl>
