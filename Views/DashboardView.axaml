<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:vmc="using:SiagaApi.ViewModels.Components"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Dashboard">
                <components:BilahAtasView.Aksi>
                    <!-- Aksi utama halaman: ambil hotspot FIRMS dan cuaca terbaru -->
                    <Button Theme="{StaticResource TombolUtama}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="{Binding LastUpdated, StringFormat='Data FIRMS terakhir diambil {0}'}"
                            Click="RefreshData_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <components:Ikon Nama="refresh-cw"
                                             Ukuran="15"
                                             Warna="{StaticResource AksenTinta}"/>
                            <TextBlock Text="Perbarui data"/>
                        </StackPanel>
                    </Button>
                </components:BilahAtasView.Aksi>
            </components:BilahAtasView>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,368">

                <!-- ================= PETA: wilayah dominan halaman ================= -->
                <Grid Grid.Column="0"
                      ClipToBounds="True"
                      Background="#0E1317">

                    <!-- Digambar dari data: lihat Components/PetaHotspot.cs.
                         Seret untuk menggeser; roda mouse, dua jari, atau cubit untuk zoom. -->
                    <components:PetaHotspot x:Name="Peta"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>

                    <!-- Ringkasan: satu baris tipis di atas peta -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="16"
                                Spacing="8">

                        <Border Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6,12">
                            <ItemsControl ItemsSource="{Binding Statistics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmc:StatCardViewModel">
                                        <StackPanel Spacing="2"
                                                    Margin="18,0">
                                            <TextBlock Text="{Binding Value}"
                                                       Classes="mono"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Warna}"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource Teks3}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Keadaan aman dinyatakan terang-terangan -->
                        <Border IsVisible="{Binding ProvinsiAman}"
                                Background="#EE12181D"
                                BorderBrush="#665CC98A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <components:Ikon Nama="shield-check"
                                                 Ukuran="15"
                                                 Warna="{StaticResource Baik}"/>
                                <TextBlock Text="Tidak ada hotspot dalam 24 jam terakhir di provinsi ini."
                                           FontSize="12.5"
                                           Foreground="{StaticResource Baik}"/>
                            </StackPanel>
                        </Border>

                        <!-- Hasil atau kegagalan pengambilan data -->
                        <Border IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                MaxWidth="560"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding MessageForeground}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>

                    <!-- Kontrol peta: mode, peta dasar, legenda -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="16"
                                Spacing="10">

                        <Border Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">
                                <Button x:Name="TombolChoropleth"
                                        Content="Choropleth"
                                        Theme="{StaticResource TombolSegmen}"
                                        ToolTip.Tip="Warnai kabupaten menurut jumlah hotspot"
                                        Click="ModeChoropleth_Click"/>
                                <Button x:Name="TombolTitik"
                                        Content="Titik"
                                        Theme="{StaticResource TombolSegmen}"
                                        ToolTip.Tip="Tampilkan tiap hotspot di lokasinya"
                                        Click="ModeTitik_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3">
                            <StackPanel x:Name="PilihanPetaDasar"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                <Button Content="Tanpa"
                                        Tag="Tanpa peta dasar"
                                        Theme="{StaticResource TombolSegmen}"
                                        ToolTip.Tip="Tanpa peta dasar (jalan tanpa internet)"
                                        Click="PetaDasar_Click"/>
                                <Button Content="Jalan"
                                        Tag="Peta jalan"
                                        Theme="{StaticResource TombolSegmen}"
                                        ToolTip.Tip="Peta jalan OpenStreetMap"
                                        Click="PetaDasar_Click"/>
                                <Button Content="Satelit"
                                        Tag="Satelit"
                                        Theme="{StaticResource TombolSegmen}"
                                        ToolTip.Tip="Citra satelit"
                                        Click="PetaDasar_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Center">
                            <Grid>
                                <StackPanel x:Name="LegendaJumlah"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <TextBlock Text="Hotspot" Classes="samar" FontSize="11.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#283037" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="0" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#4D3A30" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="1–4" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#6E4630" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="5–9" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#914D2D" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="10–17" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#C6532A" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="18–30" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="10" Height="10" CornerRadius="2" Background="#F15A24" BorderBrush="#22FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="31+" Classes="mono redup" FontSize="11.5"/></StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="LegendaConfidence"
                                            Orientation="Horizontal"
                                            Spacing="12"
                                            IsVisible="False">
                                    <TextBlock Text="Confidence" Classes="samar" FontSize="11.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{StaticResource Tinggi}" VerticalAlignment="Center"/><TextBlock Text="tinggi" Classes="redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{StaticResource Nominal}" VerticalAlignment="Center"/><TextBlock Text="nominal" Classes="redup" FontSize="11.5"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{StaticResource Baik}" VerticalAlignment="Center"/><TextBlock Text="rendah" Classes="redup" FontSize="11.5"/></StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Zoom dan kembali ke tampilan awal -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Background="{StaticResource PanelApung}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Spacing="2">
                            <Button x:Name="TombolPerbesar"
                                    Theme="{StaticResource TombolSenyap}"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    ToolTip.Tip="Perbesar"
                                    Click="ZoomIn_Click">
                                <components:Ikon Nama="plus" Ukuran="16" Warna="{StaticResource Teks}"/>
                            </Button>
                            <Button x:Name="TombolPerkecil"
                                    Theme="{StaticResource TombolSenyap}"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    ToolTip.Tip="Perkecil"
                                    Click="ZoomOut_Click">
                                <components:Ikon Nama="minus" Ukuran="16" Warna="{StaticResource Teks}"/>
                            </Button>
                            <Button x:Name="TombolAwal"
                                    Theme="{StaticResource TombolSenyap}"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    ToolTip.Tip="Kembali ke tampilan seluruh provinsi"
                                    Click="ResetPeta_Click">
                                <components:Ikon Nama="locate-fixed" Ukuran="16" Warna="{StaticResource Teks}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ================= INSPEKTUR: kabupaten terpilih ================= -->
                <Border Grid.Column="1"
                        Background="{StaticResource Permukaan}"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1,0,0,0">

                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="22,20,22,18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="KABUPATEN TERPILIH"
                                           Classes="label"/>
                                <TextBlock Text="{Binding NamaTerpilih}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Teks}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RingkasTerpilih}"
                                           FontSize="13.5"
                                           Classes="redup"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="22,16">
                            <StackPanel Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Indeks risiko"
                                               FontSize="13"
                                               Classes="redup"
                                               VerticalAlignment="Bottom"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{Binding RisikoNilai}"
                                                   Classes="mono"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Teks}"
                                                   VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding RisikoKeterangan}"
                                                   FontSize="12.5"
                                                   Foreground="{Binding RisikoBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,3"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Height="6">
                                    <Border CornerRadius="3"
                                            Background="{StaticResource Permukaan2}"/>
                                    <Border CornerRadius="3"
                                            Width="{Binding RisikoLebar}"
                                            Background="{Binding RisikoBrush}"
                                            HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*"
                                      Margin="0,4,0,0">
                                    <StackPanel Spacing="3">
                                        <components:Ikon Nama="thermometer" Ukuran="15" Warna="{StaticResource Teks3}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding CuacaSuhu}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                        <TextBlock Text="suhu" Classes="samar" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <components:Ikon Nama="droplets" Ukuran="15" Warna="{StaticResource Teks3}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding CuacaKelembapan}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                        <TextBlock Text="kelembapan" Classes="samar" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <components:Ikon Nama="wind" Ukuran="15" Warna="{StaticResource Teks3}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding CuacaAngin}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                        <TextBlock Text="{Binding CuacaArah}" Classes="samar" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding DetailInfo}"
                                           IsVisible="{Binding DetailInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{StaticResource Nominal}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>

                        <!-- Hotspot 24 jam kabupaten terpilih, confidence tertinggi dulu -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,16,22,8">

                                <TextBlock Text="HOTSPOT 24 JAM"
                                           Classes="label"
                                           Margin="0,0,0,2"/>

                                <StackPanel IsVisible="{Binding DetailKosong}"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,12,0,0">
                                    <components:Ikon Nama="shield-check" Ukuran="15" Warna="{StaticResource Baik}"/>
                                    <TextBlock Text="Aman: tidak ada deteksi di kabupaten ini."
                                               FontSize="13"
                                               Foreground="{StaticResource Baik}"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding HotspotItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotspotItemViewModel">
                                            <Border BorderBrush="{StaticResource Garis}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,12">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Ellipse Width="10"
                                                             Height="10"
                                                             Fill="{Binding TitikBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Koordinat}"
                                                                   Classes="mono"
                                                                   FontSize="13.5"
                                                                   Foreground="{StaticResource Teks}"/>
                                                        <TextBlock Text="{Binding Keterangan}"
                                                                   FontSize="12"
                                                                   Foreground="{Binding StatusForeground}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Waktu}"
                                                               Classes="mono samar"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,1,0,0"
                                Padding="22,16,22,20">
                            <StackPanel Spacing="10">
                                <Button Theme="{StaticResource TombolNetral}"
                                        Background="{StaticResource Permukaan2}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,12"
                                        IsEnabled="{Binding BisaSimulasi}"
                                        Click="Simulasikan_Click">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <components:Ikon Nama="flame" Ukuran="16" Warna="{StaticResource Aksen}"/>
                                        <TextBlock Text="Simulasikan klaster ini"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Hotspot adalah indikasi anomali panas, bukan kebakaran terverifikasi. Diperkuat = ada laporan warga terverifikasi dalam 5 km."
                                           Classes="samar"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
