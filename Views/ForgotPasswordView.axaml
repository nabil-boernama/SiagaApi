<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.ForgotPasswordView"
    x:DataType="vm:ForgotPasswordViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="5*,4*">

        <components:PanelSampulView Grid.Column="0"/>

        <Border Grid.Column="1"
                BorderBrush="{StaticResource Garis}"
                BorderThickness="1,0,0,0">

            <StackPanel Width="400"
                        Spacing="18"
                        VerticalAlignment="Center">

                <StackPanel Spacing="6">
                    <TextBlock Text="Lupa kata sandi?"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Teks}"/>
                    <TextBlock Text="Kata sandi tidak dikirim lewat email. Pemulihan akun dilakukan oleh admin posko, supaya hanya orang yang dikenal posko yang bisa masuk."
                               FontSize="14"
                               TextWrapping="Wrap"
                               Classes="redup"/>
                </StackPanel>

                <!-- LANGKAH PEMULIHAN -->
                <ItemsControl ItemsSource="{Binding Langkah}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LangkahPemulihan">
                            <Grid ColumnDefinitions="Auto,*"
                                  Margin="0,0,0,14">
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="{StaticResource Permukaan2}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Nomor}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Classes="mono"
                                               Foreground="{StaticResource Teks}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Teks}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Teks}"
                                           Margin="12,3,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Kembali ke halaman masuk"
                        Theme="{StaticResource TombolUtama}"
                        Height="48"
                        FontSize="15"
                        HorizontalAlignment="Stretch"
                        Click="KembaliKeLogin_Click"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Classes="samar"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>
