<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.PengaturanView"
    x:DataType="vm:PengaturanViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Pengaturan"/>

            <!-- ================= TAB ================= -->
            <Border Grid.Row="1"
                    BorderBrush="{StaticResource Garis}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <Button Content="Posko" Theme="{StaticResource TombolTab}" Classes.aktif="{Binding TabPosko}" Tag="Posko" Click="Tab_Click"/>
                    <Button Content="Sumber data" Theme="{StaticResource TombolTab}" Classes.aktif="{Binding TabSumber}" Tag="Sumber data" Click="Tab_Click"/>
                    <Button Content="Email" Theme="{StaticResource TombolTab}" Classes.aktif="{Binding TabEmail}" Tag="Email" Click="Tab_Click"/>
                    <!-- Hanya Admin dan Super Admin -->
                    <Button Theme="{StaticResource TombolTab}" Classes.aktif="{Binding TabAkun}" Tag="Akun operator" IsVisible="{Binding IsAdmin}" Click="Tab_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Akun operator" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding AdaMenunggu}" Background="#22F2A83B" CornerRadius="20" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MenungguLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Nominal}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="Keamanan" Theme="{StaticResource TombolTab}" Classes.aktif="{Binding TabKeamanan}" Tag="Keamanan" Click="Tab_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">

                <!-- ================= TAB: POSKO, SUMBER DATA, EMAIL ================= -->
                <Grid RowDefinitions="*,Auto"
                      IsVisible="{Binding TabBisaSimpan}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>

                            <!-- POSKO: dipakai bersama semua operator, tersimpan di database -->
                            <StackPanel IsVisible="{Binding TabPosko}"
                                        Width="560"
                                        HorizontalAlignment="Left"
                                        Margin="28,24"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Setelan posko" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                    <TextBlock Text="Berlaku untuk semua operator posko ini dan tersimpan di database." Classes="redup" FontSize="13.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border IsVisible="{Binding BukanAdmin}" Background="#22F2A83B" CornerRadius="8" Padding="12,9">
                                    <TextBlock Text="Hanya admin posko yang bisa mengubah setelan di tab ini." FontSize="12.5" Foreground="{StaticResource Nominal}" TextWrapping="Wrap"/>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Provinsi yang dipantau" Classes="medan"/>
                                    <ComboBox ItemsSource="{Binding ProvinsiList}" SelectedItem="{Binding SelectedProvinsi, Mode=TwoWay}" IsEnabled="{Binding IsAdmin}"/>
                                    <TextBlock Text="Daftar provinsi berasal dari wilayah yang ada di database." Classes="samar"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Peta dasar bawaan di Dashboard" Classes="medan"/>
                                    <ComboBox ItemsSource="{Binding PetaDasarList}" SelectedItem="{Binding SelectedMap, Mode=TwoWay}" IsEnabled="{Binding IsAdmin}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Perbarui data otomatis" Classes="medan"/>
                                    <ComboBox ItemsSource="{Binding IntervalList}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}" IsEnabled="{Binding IsAdmin}"/>
                                    <TextBlock Text="Hotspot, cuaca, dan peringatan email diperbarui sesuai interval ini selama aplikasi terbuka dan ada operator yang masuk." Classes="samar" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding AllowNationalMode, Mode=TwoWay}" IsEnabled="{Binding IsAdmin}" Foreground="{StaticResource Teks}" FontSize="13.5">
                                    <TextBlock Text="Tampilkan tabel Lihat nasional di halaman Riwayat (hanya baca, agregat per provinsi)" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>

                            <!-- SUMBER DATA: kunci API hanya disimpan di komputer ini -->
                            <StackPanel IsVisible="{Binding TabSumber}"
                                        Width="560"
                                        HorizontalAlignment="Left"
                                        Margin="28,24"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Sumber data" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                    <TextBlock Text="Boleh dikosongkan. Tanpa kunci, hotspot diambil dari arsip publik NASA FIRMS dan cuaca dari Open-Meteo." Classes="redup" FontSize="13.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MAP_KEY NASA FIRMS" Classes="medan"/>
                                    <TextBox Text="{Binding FirmsApiKey, Mode=TwoWay}" PasswordChar="●" FontFamily="{StaticResource HurufMono}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="API key AccuWeather" Classes="medan"/>
                                    <TextBox Text="{Binding WeatherApiKey, Mode=TwoWay}" PasswordChar="●" FontFamily="{StaticResource HurufMono}"/>
                                </StackPanel>
                                <TextBlock Text="Kunci hanya disimpan di komputer ini, tidak di database. Bila pengambilan gagal, aplikasi memakai data terakhir di database." Classes="samar" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- EMAIL: SMTP untuk peringatan ke pelanggan, hanya di komputer ini -->
                            <StackPanel IsVisible="{Binding TabEmail}"
                                        Width="560"
                                        HorizontalAlignment="Left"
                                        Margin="28,24"
                                        Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Email peringatan (SMTP)" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                    <TextBlock Text="Dipakai untuk mengirim peringatan ke pelanggan. Kosongkan semuanya bila komputer ini tidak bertugas mengirim email." Classes="redup" FontSize="13.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,12,120">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server SMTP" Classes="medan"/>
                                        <TextBox Text="{Binding SmtpServer, Mode=TwoWay}" PlaceholderText="smtp.contoh.id"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="Port" Classes="medan"/>
                                        <TextBox Text="{Binding SmtpPort, Mode=TwoWay}" FontFamily="{StaticResource HurufMono}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Alamat pengirim" Classes="medan"/>
                                    <TextBox Text="{Binding SenderEmail, Mode=TwoWay}" PlaceholderText="posko@contoh.id"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Nama pengguna SMTP" Classes="medan"/>
                                        <TextBox Text="{Binding SmtpUsername, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="Kata sandi SMTP" Classes="medan"/>
                                        <TextBox Text="{Binding SmtpPassword, Mode=TwoWay}" PasswordChar="●"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Disimpan hanya di komputer ini, tidak di database." Classes="samar"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="0,1,0,0"
                            Padding="28,14">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16">
                            <Button Content="Simpan pengaturan"
                                    Theme="{StaticResource TombolUtama}"
                                    Padding="18,11"
                                    FontSize="14"
                                    Click="SaveSettings_Click"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding MessageForeground}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       MaxWidth="640"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= TAB: AKUN OPERATOR ================= -->
                <Grid ColumnDefinitions="*,368"
                      IsVisible="{Binding TabAkun}">

                    <Grid RowDefinitions="Auto,*,Auto">

                        <Border Background="{StaticResource Permukaan}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="24,10">
                            <Grid ColumnDefinitions="*,110,120,120,330">
                                <TextBlock Text="NAMA" Classes="kolom"/>
                                <TextBlock Grid.Column="1" Text="PERAN" Classes="kolom"/>
                                <TextBlock Grid.Column="2" Text="STATUS" Classes="kolom"/>
                                <TextBlock Grid.Column="3" Text="TERDAFTAR" Classes="kolom"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AkunItemViewModel">
                                        <Border Background="{Binding LatarBaris}"
                                                BorderBrush="{StaticResource Garis}"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,12">
                                            <Grid ColumnDefinitions="*,110,120,120,330">
                                                <!-- Grid (bukan StackPanel) supaya nama dan email yang panjang terpotong, tidak menabrak kolom Peran -->
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,16,0" ToolTip.Tip="{Binding Rincian}">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Permukaan2}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Inisial}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Teks}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NamaLengkap}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Teks}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding NamaPengguna}" Classes="mono samar" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Peran}" Classes="sel"/>
                                                <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="20" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusForeground}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusForeground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding Terdaftar}" Classes="sel mono redup"/>
                                                <!-- Tombol yang tampil mengikuti wewenang (lihat AkunOperator.BolehMengelola) -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <Button Content="Tolak" Theme="{StaticResource TombolBaris}" IsVisible="{Binding BisaSetujui}" Click="TolakAkun_Click"/>
                                                    <Button Content="Setujui" Theme="{StaticResource TombolBarisUtama}" IsVisible="{Binding BisaSetujui}" Click="SetujuiAkun_Click"/>
                                                    <Button Content="Aktifkan" Theme="{StaticResource TombolBaris}" IsVisible="{Binding BisaAktifkan}" Click="AktifkanAkun_Click"/>
                                                    <Button Content="Jadikan admin" Theme="{StaticResource TombolBaris}" IsVisible="{Binding BisaJadikanAdmin}" Click="JadikanAdmin_Click"/>
                                                    <Button Content="Jadikan operator" Theme="{StaticResource TombolBaris}" IsVisible="{Binding BisaJadikanOperator}" Click="JadikanOperator_Click"/>
                                                    <Button Content="Reset sandi" Theme="{StaticResource TombolBaris}" IsVisible="{Binding BisaResetSandi}" Click="ResetSandi_Click"/>
                                                    <Button Content="Nonaktifkan" Theme="{StaticResource TombolBarisBahaya}" IsVisible="{Binding BisaNonaktifkan}" Click="NonaktifkanAkun_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Margin="24,14"
                                    Spacing="6">
                            <!-- Hasil aksi, termasuk kata sandi sementara yang bisa diblok dan disalin -->
                            <SelectableTextBlock Text="{Binding AdminMessage}"
                                                 IsVisible="{Binding AdminMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 FontSize="13"
                                                 Foreground="{Binding AdminMessageForeground}"
                                                 TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AccountsTitle}" Classes="samar"/>
                            <TextBlock Text="Yang menunggu persetujuan selalu di atas. Anda tidak bisa mengubah akun sendiri." Classes="samar"/>
                        </StackPanel>

                    </Grid>

                    <Border Grid.Column="1"
                            Background="{StaticResource Permukaan}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Garis}"
                                    BorderThickness="0,0,0,1"
                                    Padding="22,20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="KODE UNDANGAN POSKO" Classes="label"/>
                                    <Border Background="{StaticResource Latar}" BorderBrush="{StaticResource Garis}" BorderThickness="1" CornerRadius="8" Padding="16,12,8,12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Text="{Binding InvitationCode}" FontFamily="{StaticResource HurufMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Teks}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Theme="{StaticResource TombolSenyap}" ToolTip.Tip="Salin kode" Click="SalinKode_Click">
                                                <components:Ikon x:Name="IkonSalin" Nama="copy" Ukuran="18" Warna="{StaticResource Teks2}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Bagikan ke calon operator untuk halaman Daftar. Akun baru tetap harus disetujui di sini." Classes="redup" FontSize="12.5" TextWrapping="Wrap"/>
                                    <Button Theme="{StaticResource TombolNetral}" HorizontalAlignment="Left" Click="BuatKodeUndangan_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <components:Ikon Nama="refresh-cw" Ukuran="15" Warna="{StaticResource Teks2}"/>
                                            <TextBlock Text="Buat kode baru" FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Kode lama langsung tidak berlaku." Classes="samar" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="22,20" Spacing="14">
                                <TextBlock Text="TIGA PERAN" Classes="label"/>
                                <StackPanel Spacing="2"><TextBlock Text="Super Admin" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/><TextBlock Text="Mengelola semua akun dan mengubah peran." Classes="redup" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Spacing="2"><TextBlock Text="Admin" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/><TextBlock Text="Menyetujui pendaftar, mengelola Operator, membuat kode." Classes="redup" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Spacing="2"><TextBlock Text="Operator" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/><TextBlock Text="Memakai aplikasi, tidak melihat tab ini." Classes="redup" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= TAB: KEAMANAN ================= -->
                <ScrollViewer IsVisible="{Binding TabKeamanan}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="560"
                                HorizontalAlignment="Left"
                                Margin="28,24"
                                Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ganti kata sandi" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="{Binding AkunSaya}" Classes="redup" FontSize="13.5"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Kata sandi lama" Classes="medan"/>
                            <TextBox x:Name="SandiLamaTextBox" PasswordChar="●"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Kata sandi baru (min. 8 karakter)" Classes="medan"/>
                                <TextBox x:Name="SandiBaruTextBox" PasswordChar="●"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Ulangi kata sandi baru" Classes="medan"/>
                                <TextBox x:Name="SandiKonfirmasiTextBox" PasswordChar="●"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SandiMessage}"
                                   IsVisible="{Binding SandiMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12.5"
                                   Foreground="{Binding SandiMessageForeground}"
                                   TextWrapping="Wrap"/>
                        <Button Content="Ganti kata sandi"
                                Theme="{StaticResource TombolUtama}"
                                Padding="18,11"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                Click="GantiKataSandi_Click"/>
                        <TextBlock Text="Setelah diganti, fitur Ingat saya dimatikan di semua komputer dan Anda masuk lagi dengan kata sandi baru." Classes="samar" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
