<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.LoginView"
    x:DataType="vm:LoginViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="5*,4*">

        <components:PanelSampulView Grid.Column="0"/>

        <Border Grid.Column="1"
                BorderBrush="{StaticResource Garis}"
                BorderThickness="1,0,0,0">

            <StackPanel Width="380"
                        Spacing="18"
                        VerticalAlignment="Center">

                <StackPanel Spacing="4"
                            Margin="0,0,0,6">
                    <TextBlock Text="Masuk"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Teks}"/>
                    <TextBlock Text="Akun operator posko"
                               FontSize="14"
                               Classes="redup"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Nama pengguna"
                               Classes="medan"/>
                    <TextBox x:Name="UsernameTextBox"
                             MinHeight="46"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Kata sandi"
                               Classes="medan"/>
                    <Grid>
                        <TextBox x:Name="PasswordTextBox"
                                 MinHeight="46"
                                 Padding="12,10,44,10"
                                 PasswordChar="●"/>
                        <Button Theme="{StaticResource TombolSenyap}"
                                HorizontalAlignment="Right"
                                Margin="0,0,6,0"
                                ToolTip.Tip="Tampilkan atau sembunyikan kata sandi"
                                Click="LihatSandi_Click">
                            <components:Ikon x:Name="IkonLihatSandi"
                                             Nama="eye"
                                             Ukuran="16"
                                             Warna="{StaticResource Teks2}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <CheckBox x:Name="RememberMeCheckBox"
                              Content="Ingat saya di komputer ini"
                              IsChecked="True"
                              FontSize="13"
                              Foreground="{StaticResource Teks2}"/>
                    <Button Grid.Column="1"
                            Theme="{StaticResource TombolSenyap}"
                            Padding="4,2"
                            Click="ForgotPassword_Click">
                        <TextBlock Text="Lupa kata sandi?"
                                   FontSize="13"/>
                    </Button>
                </Grid>

                <!-- Pesan: kata sandi salah, akun belum disetujui, database mati -->
                <TextBlock Text="{Binding Message}"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource Tinggi}"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <!-- Enter juga menekan tombol ini -->
                <Button Content="Masuk"
                        Theme="{StaticResource TombolUtama}"
                        Height="48"
                        FontSize="15"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        IsEnabled="{Binding !IsBusy}"
                        Click="LoginButton_Click"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="Belum punya akun?"
                               FontSize="13"
                               Classes="redup"
                               VerticalAlignment="Center"/>
                    <Button x:Name="RegisterLink"
                            Theme="{StaticResource TombolSenyap}"
                            Padding="5,2"
                            Click="Register_Click">
                        <TextBlock Text="Daftar dengan kode undangan"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Aksen}"/>
                    </Button>
                </StackPanel>

                <!-- Hanya muncul kalau database tidak terjangkau -->
                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding DatabaseBermasalah}"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,20,0,0">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{Binding DatabaseBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DatabaseStatus}"
                               Classes="samar"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>
