<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels.Components"
    x:Class="SiagaApi.Views.Components.StatCardView"
    x:DataType="vm:StatCardViewModel">

    <Border Background="#1C2329"
            BorderBrush="#303A42"
            BorderThickness="1"
            CornerRadius="11"
            Padding="19">

        <StackPanel Spacing="5">

            <TextBlock Text="{Binding Label}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#95A2AD"/>

            <TextBlock Text="{Binding Value}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#E5E9ED"/>

            <TextBlock Text="{Binding Description}"
                       FontSize="13"
                       Foreground="#95A2AD"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Border>
</UserControl>