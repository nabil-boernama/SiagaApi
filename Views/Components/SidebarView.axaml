<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.Components.SidebarView"
    Width="76"
    Loaded="SidebarView_Loaded">

    <!-- Rel navigasi: ikon + label pendek. Tombolnya dibuat di SidebarView.axaml.cs
         dari satu daftar, supaya urutan dan nama halaman hanya ditulis sekali. -->
    <Border Background="{StaticResource Permukaan}"
            BorderBrush="{StaticResource Garis}"
            BorderThickness="0,0,1,0">

        <Grid RowDefinitions="Auto,*,Auto"
              Margin="0,16">

            <StackPanel Grid.Row="0"
                        Spacing="6"
                        HorizontalAlignment="Center">

                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="#14181B"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        ToolTip.Tip="SiagaApi">
                    <components:LogoTanda Tinggi="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel x:Name="Menu"
                            Spacing="6"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Spacing="6"
                        HorizontalAlignment="Center">

                <Border x:Name="Avatar"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="{StaticResource Permukaan2}"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="OperatorNameText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Teks}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Theme="{StaticResource TombolSenyap}"
                        Padding="6,3"
                        HorizontalAlignment="Center"
                        Click="LogoutButton_Click">
                    <TextBlock x:Name="LogoutText"
                               Text="Keluar"
                               FontSize="10.5"/>
                </Button>

            </StackPanel>

        </Grid>
    </Border>

</UserControl>
