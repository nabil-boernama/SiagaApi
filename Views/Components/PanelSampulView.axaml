<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.Components.PanelSampulView">

    <!-- Sisi kiri halaman Masuk, Daftar, dan Lupa kata sandi:
         citra satelit Riau, logo, dan satu kalimat tentang aplikasinya. -->
    <Grid ClipToBounds="True">

        <Border>
            <Border.Background>
                <ImageBrush Source="/Assets/login-peta.jpg"
                            Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <!-- Digelapkan ke arah bawah supaya teks terbaca di atas foto -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#550B0F12" Offset="0"/>
                    <GradientStop Color="#000B0F12" Offset="0.35"/>
                    <GradientStop Color="#F20B0F12" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto"
              Margin="40">

            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <components:LogoTanda Tinggi="44"/>
                <TextBlock Text="SiagaApi"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Teks}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Spacing="12"
                        MaxWidth="520"
                        HorizontalAlignment="Left">

                <TextBlock Text="Dari sinyal satelit menuju keputusan."
                           FontSize="40"
                           FontWeight="SemiBold"
                           LineHeight="45"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Teks}"/>

                <TextBlock Text="Hotspot, cuaca, dan laporan warga dalam satu peta untuk operator posko karhutla."
                           FontSize="16"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Teks2}"/>

                <TextBlock Text="Riau · citra: Esri, Maxar, Earthstar Geographics · batas: OpenStreetMap"
                           FontSize="11.5"
                           Foreground="{StaticResource Teks3}"/>

            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
