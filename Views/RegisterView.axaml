<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.RegisterView"
    x:DataType="vm:RegisterViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="5*,4*">

        <components:PanelSampulView Grid.Column="0"/>

        <Border Grid.Column="1"
                BorderBrush="{StaticResource Garis}"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="420"
                            Spacing="16"
                            Margin="0,32"
                            VerticalAlignment="Center">

                    <StackPanel Spacing="4"
                                Margin="0,0,0,4">
                        <TextBlock Text="Buat akun operator"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Teks}"/>
                        <TextBlock Text="Butuh kode undangan dari admin posko. Akun aktif setelah disetujui admin."
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Classes="redup"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Nama lengkap"
                                   Classes="medan"/>
                        <TextBox x:Name="FullNameTextBox"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Username"
                                       Classes="medan"/>
                            <TextBox x:Name="UsernameTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Spacing="6">
                            <TextBlock Text="Email"
                                       Classes="medan"/>
                            <TextBox x:Name="EmailTextBox"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Kata sandi (min. 8 karakter)"
                                       Classes="medan"/>
                            <TextBox x:Name="PasswordTextBox"
                                     PasswordChar="●"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Spacing="6">
                            <TextBlock Text="Ulangi kata sandi"
                                       Classes="medan"/>
                            <TextBox x:Name="ConfirmPasswordTextBox"
                                     PasswordChar="●"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Kode undangan posko"
                                   Classes="medan"/>
                        <TextBox x:Name="InvitationCodeTextBox"
                                 FontFamily="{StaticResource HurufMono}"
                                 PlaceholderText="XXXX-XXXX"/>
                    </StackPanel>

                    <!-- Pesan hasil pendaftaran -->
                    <TextBlock Text="{Binding Message}"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{Binding MessageForeground}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <Button Content="Buat akun"
                            Theme="{StaticResource TombolUtama}"
                            Height="48"
                            FontSize="15"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !IsBusy}"
                            Click="CreateAccount_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="Sudah punya akun?"
                                   FontSize="13"
                                   Classes="redup"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="LoginLink"
                                Theme="{StaticResource TombolSenyap}"
                                Padding="5,2"
                                Click="Login_Click">
                            <TextBlock Text="Masuk"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Aksen}"/>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

</UserControl>
