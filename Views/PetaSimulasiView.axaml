<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.PetaSimulasiView"
    x:DataType="vm:PetaSimulasiViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Simulasi penyebaran"/>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,368">

                <!-- ================= PETA PELUANG ================= -->
                <Grid Grid.Column="0"
                      ClipToBounds="True"
                      Background="#0E1513">

                    <!-- Digambar dari hasil simulasi: lihat PetaSimulasiView.axaml.cs. Atas = utara. -->
                    <Viewbox Stretch="Uniform"
                             Margin="24,84,24,96">
                        <Grid Width="900" Height="620" ClipToBounds="True">
                            <Canvas x:Name="PetaKanvas" IsHitTestVisible="False"/>
                            <Canvas x:Name="GridKanvas" Width="900" Height="620"/>
                            <TextBlock x:Name="AtribusiPeta" Text="© OpenStreetMap contributors"
                                       IsVisible="{Binding AdaHasil}" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Background="#D0000000" Foreground="White"
                                       Padding="5,2" FontSize="12"/>
                        </Grid>
                    </Viewbox>

                    <!-- Arah dorongan angin: panah diputar sesuai data cuaca -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="16"
                                Spacing="8">

                        <Border IsVisible="{Binding AdaHasil}"
                                Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9,14,9"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <components:Ikon x:Name="PanahAngin"
                                                 Nama="arrow-up"
                                                 Ukuran="18"
                                                 Warna="{StaticResource Teks}"/>
                                <TextBlock Text="{Binding AnginRingkas}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource Teks}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Belum ada hotspot, belum ada cuaca, atau simulasi gagal -->
                        <Border IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="{StaticResource PanelApung}"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                MaxWidth="560"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding MessageForeground}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,26,20,0"
                                Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="10" Height="10" Fill="{StaticResource Tinggi}" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center"/><TextBlock Text="hotspot asli" Classes="redup" FontSize="11.5"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource Aksen}" VerticalAlignment="Center"/><TextBlock Text="luas petak awal" Classes="redup" FontSize="11.5"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource Nominal}" VerticalAlignment="Center"/><TextBlock Text="10–&lt;50%" Classes="redup" FontSize="11.5"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="11" Height="11" CornerRadius="2" BorderBrush="#66FFFFFF" BorderThickness="1" VerticalAlignment="Center"/><TextBlock Text="potensi hingga t+6" Classes="redup" FontSize="11.5"/></StackPanel>
                    </StackPanel>

                    <!-- Garis waktu: klik jam, atau putar otomatis -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,18"
                            Width="660"
                            Background="{StaticResource PanelApung}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8,18,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="TombolPutar"
                                    Theme="{StaticResource TombolSenyap}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="{StaticResource Permukaan2}"
                                    ToolTip.Tip="Putar dari t+0 sampai t+6"
                                    Click="Putar_Click">
                                <components:Ikon x:Name="IkonPutar"
                                                 Nama="play"
                                                 Ukuran="16"
                                                 Warna="{StaticResource Teks}"/>
                            </Button>
                            <!-- Tujuh tombol jam dibuat di PetaSimulasiView.axaml.cs -->
                            <UniformGrid x:Name="Langkah"
                                         Grid.Column="1"
                                         Rows="1"
                                         Margin="10,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="jam"
                                       Classes="samar"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </Grid>

                <!-- ================= PANEL: klaster, cuaca, hasil ================= -->
                <Border Grid.Column="1"
                        Background="{StaticResource Permukaan}"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1,0,0,0">

                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="22,20,22,18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="KLASTER YANG DISIMULASIKAN"
                                           Classes="label"/>
                                <ComboBox x:Name="PilihanKabupaten"
                                          ItemsSource="{Binding WilayahList}"
                                          SelectedItem="{Binding SelectedWilayah, Mode=TwoWay}"
                                          IsEnabled="{Binding !IsBusy}"
                                          MinHeight="46"
                                          FontSize="14"
                                          Background="{StaticResource Permukaan2}"/>
                                <TextBlock Text="{Binding HeaderSubtitle}"
                                           Classes="samar"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="22,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="CUACA DI LOKASI"
                                           Classes="label"/>
                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <components:Ikon Nama="wind" Ukuran="17" Warna="{StaticResource Teks3}"/>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding WindSpeedText}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="angin" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <components:Ikon Nama="compass" Ukuran="17" Warna="{StaticResource Teks3}"/>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding WindDirectionText}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="arah datang" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                        <components:Ikon Nama="droplets" Ukuran="17" Warna="{StaticResource Teks3}"/>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding HumidityText}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="kelembapan" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <components:Ikon Nama="thermometer" Ukuran="17" Warna="{StaticResource Teks3}"/>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding TemperatureText}" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="suhu" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WeatherSourceText}"
                                           Classes="samar"
                                           FontSize="11.5"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,18"
                                        Spacing="8">
                                <TextBlock Text="{Binding SimulationResultLabel}"
                                           Classes="label"/>
                                <TextBlock Text="{Binding SimulationArea}"
                                           Classes="mono"
                                           FontSize="36"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Teks}"/>
                                <TextBlock Text="{Binding SimulationAreaNote}"
                                           FontSize="12.5"
                                           Classes="redup"/>
                                <Grid ColumnDefinitions="*,10,*"
                                      Margin="0,8,0,4">
                                    <Border CornerRadius="8"
                                            Background="{StaticResource Permukaan2}"
                                            Padding="12,10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding LuasMungkin}" Classes="mono" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Aksen}"/>
                                            <TextBlock Text="luas petak awal" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            CornerRadius="8"
                                            Background="{StaticResource Permukaan2}"
                                            Padding="12,10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding LuasJangkauan}" Classes="mono" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                            <TextBlock Text="total hingga jam ini" Classes="samar" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SimulationDescription}"
                                           FontSize="13"
                                           Classes="redup"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,1,0,0"
                                Padding="22,16,22,20">
                            <!-- Aksi utama halaman -->
                            <Button Theme="{StaticResource TombolUtama}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,12"
                                    IsEnabled="{Binding !IsBusy}"
                                    Click="RunSimulation_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <components:Ikon Nama="rotate-cw" Ukuran="16" Warna="{StaticResource AksenTinta}"/>
                                    <TextBlock Text="Jalankan ulang simulasi"
                                               FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
