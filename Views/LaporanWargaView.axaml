<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.LaporanWargaView"
    x:DataType="vm:LaporanWargaViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Laporan warga">
                <components:BilahAtasView.Aksi>
                    <!-- Aksi utama halaman; disembunyikan selagi formulirnya terbuka -->
                    <Button Theme="{StaticResource TombolUtama}"
                            IsVisible="{Binding !IsPanelOpen}"
                            Click="BukaPanel_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <components:Ikon Nama="plus" Ukuran="15" Warna="{StaticResource AksenTinta}"/>
                            <TextBlock Text="Laporan baru"/>
                        </StackPanel>
                    </Button>
                </components:BilahAtasView.Aksi>
            </components:BilahAtasView>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto">

                <!-- ================= TABEL ================= -->
                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Saringan status dan pencarian -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          Margin="24,16">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringSemua}" Tag="Semua" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Semua"/><TextBlock Text="{Binding JumlahSemua}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringMenunggu}" Tag="Menunggu" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Menunggu"/><TextBlock Text="{Binding JumlahMenunggu}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringTerverifikasi}" Tag="Terverifikasi" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Terverifikasi"/><TextBlock Text="{Binding JumlahTerverifikasi}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              Margin="10,0,0,0">
                            <TextBox x:Name="KotakCari"
                                     Text="{Binding Cari, Mode=TwoWay}"
                                     PlaceholderText="Cari pelapor atau wilayah"
                                     Padding="36,8,12,8"
                                     MinHeight="38"/>
                            <components:Ikon Nama="search" Ukuran="15" Warna="{StaticResource Teks3}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource Permukaan}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="0,0,0,1"
                            Padding="24,10">
                        <Grid ColumnDefinitions="90,180,130,180,150,*">
                            <TextBlock Text="WAKTU" Classes="kolom"/>
                            <TextBlock Grid.Column="1" Text="WILAYAH" Classes="kolom"/>
                            <TextBlock Grid.Column="2" Text="KEPARAHAN" Classes="kolom"/>
                            <TextBlock Grid.Column="3" Text="COCOK HOTSPOT" Classes="kolom"/>
                            <TextBlock Grid.Column="4" Text="STATUS" Classes="kolom"/>
                            <TextBlock Grid.Column="5" Text="PELAPOR" Classes="kolom"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Reports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LaporanItemViewModel">
                                    <Border BorderBrush="{StaticResource Garis}"
                                            BorderThickness="0,0,0,1"
                                            Padding="24,15">
                                        <Grid ColumnDefinitions="90,180,130,180,150,*">
                                            <TextBlock Text="{Binding Waktu}" Classes="sel mono redup"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Wilayah}" Classes="sel" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Keparahan}" Classes="sel"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CocokHotspot}" Classes="sel redup"/>
                                            <Border Grid.Column="4"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="20"
                                                    Padding="9,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusForeground}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding Pelapor}" Classes="sel"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3"
                                Margin="24,14"
                                Spacing="6">
                        <!-- Hasil simpan terakhir (panel sudah tertutup) -->
                        <TextBlock Text="{Binding Message}"
                                   IsVisible="{Binding !IsPanelOpen}"
                                   Foreground="{Binding MessageForeground}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Keterangan}"
                                   Classes="samar"/>
                    </StackPanel>

                </Grid>

                <!-- ================= PANEL: laporan baru ================= -->
                <Border Grid.Column="1"
                        Width="368"
                        IsVisible="{Binding IsPanelOpen}"
                        Background="{StaticResource Permukaan}"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1,0,0,0">

                    <Grid RowDefinitions="*,Auto">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,20"
                                        Spacing="16">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Laporan baru"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Teks}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Theme="{StaticResource TombolSenyap}"
                                            ToolTip.Tip="Tutup tanpa menyimpan"
                                            Click="TutupPanel_Click">
                                        <components:Ikon Nama="x" Ukuran="18" Warna="{StaticResource Teks2}"/>
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Nama pelapor" Classes="medan"/>
                                    <TextBox Text="{Binding NamaPelapor, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wilayah" Classes="medan"/>
                                    <ComboBox ItemsSource="{Binding WilayahList}"
                                              SelectedItem="{Binding SelectedWilayah, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Keparahan" Classes="medan"/>
                                    <Grid ColumnDefinitions="*,8,*,8,*">
                                        <Button Theme="{StaticResource TombolPilihan}" Classes.aktif="{Binding KeparahanAsap}" Tag="Asap saja" Click="Keparahan_Click">
                                            <StackPanel Spacing="6"><components:Ikon Nama="cloud" Ukuran="18" Warna="{StaticResource Teks2}" HorizontalAlignment="Center"/><TextBlock Text="Asap saja" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Theme="{StaticResource TombolPilihan}" Classes.aktif="{Binding KeparahanApi}" Tag="Api terlihat" Click="Keparahan_Click">
                                            <StackPanel Spacing="6"><components:Ikon Nama="flame" Ukuran="18" Warna="{StaticResource Teks2}" HorizontalAlignment="Center"/><TextBlock Text="Api terlihat" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Theme="{StaticResource TombolPilihan}" Classes.aktif="{Binding KeparahanBesar}" Tag="Api besar" Click="Keparahan_Click">
                                            <StackPanel Spacing="6"><components:Ikon Nama="flame-kindling" Ukuran="18" Warna="{StaticResource Teks2}" HorizontalAlignment="Center"/><TextBlock Text="Api besar" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Deskripsi kejadian" Classes="medan"/>
                                    <TextBox Text="{Binding Deskripsi, Mode=TwoWay}"
                                             Classes="multibaris"/>
                                </StackPanel>

                                <TextBlock Text="Lokasi laporan memakai titik tengah kabupaten. Laporan langsung dicocokkan dengan hotspot dalam radius 5 km."
                                           Classes="samar"
                                           TextWrapping="Wrap"/>

                                <!-- Kolom yang belum diisi atau kegagalan simpan -->
                                <TextBlock Text="{Binding Message}"
                                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding MessageForeground}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,1,0,0"
                                Padding="22,16,22,20">
                            <Grid ColumnDefinitions="*,10,Auto">
                                <Button Content="Simpan laporan"
                                        Theme="{StaticResource TombolUtama}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,12"
                                        FontSize="14"
                                        Click="SaveReport_Click"/>
                                <Button Grid.Column="2"
                                        Content="Batal"
                                        Theme="{StaticResource TombolNetral}"
                                        Padding="18,12"
                                        FontSize="14"
                                        Foreground="{StaticResource Teks2}"
                                        Click="TutupPanel_Click"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
