<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.RiwayatTrenView"
    x:DataType="vm:RiwayatTrenViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Riwayat &amp; tren"/>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,*"
                  Margin="28,24,28,28">

                <!-- Tiga angka ringkas (tanpa kotak) dan kontrol wilayah / rentang -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,24">

                    <StackPanel Orientation="Horizontal"
                                Spacing="44">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalHotspot}" Classes="mono" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="{Binding LabelTotal}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="{Binding RentangTanggal}" Classes="samar"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding PuncakHarian}" Classes="mono" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource Aksen}"/>
                            <TextBlock Text="puncak harian" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="{Binding TanggalPuncak}" Classes="samar"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding RataRataHarian}" Classes="mono" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="rata-rata 7 hari" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Teks}"/>
                            <TextBlock Text="{Binding PerbandinganRataRata}" Classes="samar"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Bottom">
                        <ComboBox ItemsSource="{Binding WilayahList}"
                                  SelectedItem="{Binding SelectedWilayah, Mode=TwoWay}"
                                  MinWidth="230"
                                  MinHeight="38"/>
                        <Border BorderBrush="{StaticResource Garis}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">
                                <Button Content="14 hari" Theme="{StaticResource TombolSegmen}" Classes.aktif="{Binding Rentang14}" Tag="14" Click="Rentang_Click"/>
                                <Button Content="30 hari" Theme="{StaticResource TombolSegmen}" Classes.aktif="{Binding Rentang30}" Tag="30" Click="Rentang_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="1">

                    <!-- ================= LIHAT NASIONAL (bisa dimatikan di Pengaturan) ================= -->
                    <Border DockPanel.Dock="Right"
                            Width="400"
                            IsVisible="{Binding TampilkanNasional}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="1,0,0,0"
                            Padding="24,0,0,0"
                            Margin="24,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="LIHAT NASIONAL · HOTSPOT 24 JAM"
                                           Classes="label"/>
                                <ItemsControl ItemsSource="{Binding Nasional}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingkasanProvinsiViewModel">
                                            <Border BorderBrush="{StaticResource Garis}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,16">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Provinsi}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Teks}" VerticalAlignment="Center"/>
                                                            <Border IsVisible="{Binding Posko}" Background="{StaticResource Permukaan2}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                                <TextBlock Text="posko ini" FontSize="11" Foreground="{StaticResource Teks2}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Hotspot}" Classes="mono" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teks}"/>
                                                    </Grid>
                                                    <Grid Height="5">
                                                        <Border CornerRadius="3" Background="{StaticResource Permukaan2}"/>
                                                        <Border CornerRadius="3" Width="{Binding Lebar}" Background="{Binding WarnaBatang}" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Kabupaten}" Classes="samar"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusForeground}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Hanya provinsi yang kabupatennya ada di database. Hanya baca."
                                           Classes="samar"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================= GRAFIK ================= -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Text="{Binding JudulGrafik}"
                                   Classes="label"
                                   Margin="0,0,0,14"/>

                        <!-- Batang rata bawah; tinggi dihitung terhadap puncak rentang -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding HotspotHarian}"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HotspotHarianViewModel">
                                        <StackPanel VerticalAlignment="Bottom"
                                                    Spacing="8"
                                                    Margin="5,0">
                                            <TextBlock Text="{Binding Jumlah}"
                                                       Classes="mono"
                                                       FontSize="{Binding $parent[ItemsControl].((vm:RiwayatTrenViewModel)DataContext).UkuranAngkaBatang}"
                                                       Foreground="{Binding WarnaAngka}"
                                                       HorizontalAlignment="Center"/>
                                            <Border Height="{Binding TinggiBatang}"
                                                    Background="{Binding Warna}"
                                                    CornerRadius="4,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding HotspotHarian}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HotspotHarianViewModel">
                                    <TextBlock Text="{Binding Tanggal}"
                                               Classes="mono"
                                               FontSize="{Binding $parent[ItemsControl].((vm:RiwayatTrenViewModel)DataContext).UkuranAngkaBatang}"
                                               Foreground="{Binding WarnaTanggal}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="3"
                                    Spacing="8"
                                    Margin="0,16,0,0">
                            <!-- Hari tanpa hotspot dinyatakan sebagai kabar baik -->
                            <Border Background="#1A5CC98A"
                                    CornerRadius="8"
                                    Padding="12,10,14,10"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <components:Ikon Nama="shield-check" Ukuran="16" Warna="{StaticResource Baik}"/>
                                    <TextBlock Text="{Binding KabarBaik}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource Baik}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Message}"
                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{StaticResource Tinggi}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </Grid>
                </DockPanel>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
