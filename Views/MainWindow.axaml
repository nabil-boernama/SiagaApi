<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:local="using:SiagaApi"
    x:Class="SiagaApi.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="SiagaApi"
    Width="1440"
    Height="900"
    MinWidth="1180"
    MinHeight="720"
    WindowStartupLocation="CenterScreen"
    Icon="/Assets/siagaapi.ico"
    FontFamily="{StaticResource HurufUi}"
    Background="{StaticResource Latar}">

    <Window.DataTemplates>
        <local:ViewLocator/>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentPage}"/>

</Window>