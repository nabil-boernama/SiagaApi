
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SiagaApi.Views.MainWindow"
        Title="SiagaApi — Daftar Akun Operator"
        Width="1280"
        Height="850"
        MinWidth="950"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#14181B">

    <Window.Resources>

        <!-- COLOR PALETTE -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#14181B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C2329"/>

        <SolidColorBrush x:Key="InputBrush" Color="#14181B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303A42"/>
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#667681"/>
        <SolidColorBrush x:Key="BorderFocusBrush" Color="#95A2AD"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#F15A24"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E64F1F"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#D94C1C"/>

        <SolidColorBrush x:Key="TextBrush" Color="#E5E9ED"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#95A2AD"/>

        <!-- CUSTOM BUTTON THEME -->
        <ControlTheme x:Key="PrimaryButtonTheme"
                      TargetType="Button">

            <Setter Property="Background" Value="#F15A24"/>
            <Setter Property="Foreground" Value="#14181B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            BorderThickness="0">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- HOVER: SLIGHTLY DARKER ORANGE -->
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#E64F1F"/>
            </Style>

            <!-- PRESSED: DARKER ORANGE -->
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#D94C1C"/>
            </Style>

            <!-- DISABLED -->
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="#713B2A"/>
                <Setter Property="Foreground" Value="#95A2AD"/>
            </Style>

        </ControlTheme>

    </Window.Resources>


    <Window.Styles>

        <!-- INPUT DEFAULT -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#303A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#805A3528"/>
        </Style>

        <!-- INPUT HOVER -->
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#667681"/>
        </Style>

        <!-- INPUT FOCUS -->
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#95A2AD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- INPUT TEMPLATE -->
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#303A42"/>
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#667681"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#95A2AD"/>
        </Style>


        <!-- LOGIN LINK -->
        <Style Selector="TextBlock.login-link">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- LOGIN LINK HOVER -->
        <Style Selector="TextBlock.login-link:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

    </Window.Styles>


    <Grid ColumnDefinitions="1*, 1*">

        <!-- LEFT: BRANDING PANEL -->
        <Border Grid.Column="0"
                Background="#1C2329"
                Padding="52,65,65,40">

            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Spacing="0">

                    <!-- BRAND -->
                    <TextBlock Text="SiagaApi"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,30"/>

                    <!-- HEADLINE -->
                    <TextBlock Text="Dari sinyal satelit&#10;menuju keputusan."
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="46"
                               Margin="0,0,0,24"/>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="Pusat pemantauan karhutla untuk operator posko: hotspot, prediksi arah rambat, dan peringatan ke warga."
                               FontSize="17"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               LineHeight="27"
                               Margin="0,0,0,28"/>

                    <!-- FEATURES -->
                    <StackPanel Spacing="20">

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="●"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="16"/>

                            <TextBlock Text="Prediksi arah rambat api"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="●"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="16"/>

                            <TextBlock Text="Peringatan email ke warga terdampak"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="●"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="16"/>

                            <TextBlock Text="Verifikasi lewat laporan lapangan"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"/>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>

                <!-- FOOTER -->
                <TextBlock Grid.Row="2"
                           Text="Hotspot adalah indikasi anomali panas, bukan kebakaran terverifikasi."
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>

            </Grid>
        </Border>


        <!-- RIGHT: REGISTRATION FORM -->
        <Grid Grid.Column="1"
              Background="{StaticResource BackgroundBrush}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Border Width="455"
                        MaxWidth="455"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="30"
                        Margin="24">

                    <StackPanel Spacing="0">

                        <!-- FORM HEADER -->
                        <TextBlock Text="DAFTAR AKUN OPERATOR"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Buat akun baru"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Akun aktif setelah disetujui admin posko."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,22"/>


                        <!-- NAMA LENGKAP -->
                        <TextBlock Text="Nama lengkap"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox Margin="0,0,0,16"/>


                        <!-- USERNAME -->
                        <TextBlock Text="Username"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox Margin="0,0,0,16"/>


                        <!-- EMAIL -->
                        <TextBlock Text="Email"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox Margin="0,0,0,16"/>


                        <!-- PASSWORD -->
                        <TextBlock Text="Kata sandi"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox PasswordChar="●"
                                 Margin="0,0,0,5"/>

                        <TextBlock Text="Minimal 8 karakter"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,16"/>


                        <!-- CONFIRM PASSWORD -->
                        <TextBlock Text="Konfirmasi kata sandi"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox PasswordChar="●"
                                 Margin="0,0,0,16"/>


                        <!-- INVITATION CODE -->
                        <TextBlock Text="Kode undangan posko"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,7"/>

                        <TextBox Margin="0,0,0,20"/>


                        <!-- REGISTER BUTTON -->
                        <Button Theme="{StaticResource PrimaryButtonTheme}"
                                Content="Buat akun"
                                Margin="0,0,0,18"/>


                        <!-- LOGIN LINK -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="5">

                            <TextBlock Text="Sudah punya akun?"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="Masuk"
                                       Classes="login-link"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
