<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.LanggananView"
    x:DataType="vm:LanggananViewModel"
    Background="{StaticResource Latar}">

    <Grid ColumnDefinitions="Auto,*">

        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <components:BilahAtasView Grid.Row="0"
                                      Judul="Langganan warga"/>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,368">

                <!-- ================= TABEL LANGGANAN ================= -->
                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto,*,Auto">

                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          Margin="24,16">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringSemua}" Tag="Semua" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Semua"/><TextBlock Text="{Binding JumlahSemua}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringAktif}" Tag="Aktif" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Aktif"/><TextBlock Text="{Binding JumlahAktif}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                            <Button Theme="{StaticResource TombolCip}" Classes.aktif="{Binding SaringDijeda}" Tag="Dijeda" Click="Saring_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Dijeda"/><TextBlock Text="{Binding JumlahDijeda}" Classes="mono" FontSize="12" Foreground="{StaticResource Teks3}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              Margin="10,0,0,0">
                            <TextBox Text="{Binding Cari, Mode=TwoWay}"
                                     PlaceholderText="Cari email atau wilayah"
                                     Padding="36,8,12,8"
                                     MinHeight="38"/>
                            <components:Ikon Nama="search" Ukuran="15" Warna="{StaticResource Teks3}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource Permukaan}"
                            BorderBrush="{StaticResource Garis}"
                            BorderThickness="0,0,0,1"
                            Padding="24,10">
                        <Grid ColumnDefinitions="*,170,100,120,190">
                            <TextBlock Text="EMAIL" Classes="kolom"/>
                            <TextBlock Grid.Column="1" Text="WILAYAH" Classes="kolom"/>
                            <TextBlock Grid.Column="2" Text="SEJAK" Classes="kolom"/>
                            <TextBlock Grid.Column="3" Text="STATUS" Classes="kolom"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Subscriptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanggananItemViewModel">
                                    <Border BorderBrush="{StaticResource Garis}"
                                            BorderThickness="0,0,0,1"
                                            Padding="24,11">
                                        <Grid ColumnDefinitions="*,170,100,120,190">
                                            <TextBlock Text="{Binding Email}" Classes="sel" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Wilayah}" Classes="sel"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Sejak}" Classes="sel mono redup"/>
                                            <Border Grid.Column="3"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="20"
                                                    Padding="9,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusForeground}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Jeda/lanjutkan dan hapus langganan -->
                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8">
                                                <Button Content="{Binding LabelJeda}"
                                                        Theme="{StaticResource TombolBaris}"
                                                        Click="JedaLangganan_Click"/>
                                                <Button Content="Hapus"
                                                        Theme="{StaticResource TombolBarisBahaya}"
                                                        Click="HapusLangganan_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3"
                               Text="{Binding Keterangan}"
                               Classes="samar"
                               Margin="24,14"/>

                </Grid>

                <!-- ================= PANEL: tambah langganan + riwayat peringatan ================= -->
                <Border Grid.Column="1"
                        Background="{StaticResource Permukaan}"
                        BorderBrush="{StaticResource Garis}"
                        BorderThickness="1,0,0,0">

                    <Grid RowDefinitions="Auto,*">

                        <Border BorderBrush="{StaticResource Garis}"
                                BorderThickness="0,0,0,1"
                                Padding="22,20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="LANGGANAN BARU"
                                           Classes="label"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Email warga" Classes="medan"/>
                                    <TextBox Text="{Binding Email, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wilayah dipantau" Classes="medan"/>
                                    <ComboBox ItemsSource="{Binding WilayahList}"
                                              SelectedItem="{Binding SelectedWilayah, Mode=TwoWay}"/>
                                </StackPanel>
                                <!-- Hasil tambah, jeda, atau hapus -->
                                <TextBlock Text="{Binding Message}"
                                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding MessageForeground}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"/>
                                <Button Content="Tambah langganan"
                                        Theme="{StaticResource TombolUtama}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,12"
                                        FontSize="14"
                                        Click="AddSubscription_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,18">

                                <TextBlock Text="PERINGATAN TERBARU"
                                           Classes="label"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="Belum ada peringatan yang tercatat. Catatan muncul saat hotspot baru terdeteksi di wilayah yang punya pelanggan aktif."
                                           IsVisible="{Binding TidakAdaNotifikasi}"
                                           Classes="redup"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotifikasiItemViewModel">
                                            <Border BorderBrush="{StaticResource Garis}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,11">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Email}" Classes="sel" FontSize="13"/>
                                                        <Border Grid.Column="1"
                                                                Background="{Binding HasilBackground}"
                                                                CornerRadius="20"
                                                                Padding="8,2">
                                                            <TextBlock Text="{Binding Hasil}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding HasilForeground}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Pemicu}" Classes="samar" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Waktu}" Classes="samar mono" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Satu hotspot hanya dicatat sekali per langganan. Email berbunyi indikasi titik panas, bukan kebakaran."
                                           Classes="samar"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0"/>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>

</UserControl>
