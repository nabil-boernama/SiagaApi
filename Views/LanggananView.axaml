<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiagaApi.ViewModels"
    xmlns:components="using:SiagaApi.Views.Components"
    x:Class="SiagaApi.Views.LanggananView"
    x:DataType="vm:LanggananViewModel"
    Background="#14181B">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C2329"/>
        <SolidColorBrush x:Key="InputBrush" Color="#14181B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303A42"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F15A24"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5E9ED"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#95A2AD"/>

        <ControlTheme x:Key="PrimaryButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="#F15A24"/>
            <Setter Property="Foreground" Value="#14181B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#E64F1F"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#D94C1C"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="#713B2A"/>
                <Setter Property="Foreground" Value="#95A2AD"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- TEXTBOX: SAMA DENGAN REGISTER VIEW -->
        <Style Selector="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#303A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#805A3528"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#667681"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#95A2AD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#303A42"/>
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#667681"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#95A2AD"/>
        </Style>

        <!-- COMBOBOX -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="BorderBrush" Value="#303A42"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#667681"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#95A2AD"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="260,*">
        <components:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1"
              Margin="38,34,38,30"
              RowDefinitions="Auto,*">

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,22">
                <TextBlock
                    Text="Langganan warga"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#E5E9ED"/>

                <TextBlock
                    Text="Warga memilih wilayah pantauan; sistem mengirim email saat ada indikasi hotspot baru"
                    FontSize="14"
                    Foreground="#95A2AD"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <!-- CONTENT -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="0.95*,1.8*"
                  ColumnSpacing="20"
                  VerticalAlignment="Top">

                <!-- FORM -->
                <Border Grid.Column="0"
                        Background="#1C2329"
                        BorderBrush="#303A42"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="19"
                        VerticalAlignment="Top">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="TAMBAH LANGGANAN"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#95A2AD"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Email warga"
                                       FontSize="13"
                                       Foreground="#95A2AD"/>
                            <TextBox
                                Text="{Binding Email, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Wilayah dipantau"
                                       FontSize="13"
                                       Foreground="#95A2AD"/>
                            <ComboBox
                                ItemsSource="{Binding WilayahList}"
                                SelectedItem="{Binding SelectedWilayah, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock
                            Text="Satu warga boleh memantau lebih dari satu wilayah."
                            FontSize="13"
                            Foreground="#95A2AD"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{Binding Message}"
                            FontSize="12"
                            Foreground="#78C99A"
                            TextWrapping="Wrap"/>

                        <Button
                            Content="Tambah langganan"
                            Theme="{StaticResource PrimaryButtonTheme}"
                            Click="AddSubscription_Click"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT SIDE -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- SUBSCRIPTION TABLE -->
                    <Border
                        Background="#1C2329"
                        BorderBrush="#303A42"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="19">

                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="{Binding ActiveCount, StringFormat='DAFTAR LANGGANAN · {0}'}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#95A2AD"/>

                            <Grid ColumnDefinitions="1.35*,0.8*,0.55*,0.65*"
                                  Margin="0,0,0,2">
                                <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="1" Text="WILAYAH" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="SEJAK" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Subscriptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanggananItemViewModel">
                                        <Border BorderBrush="#303A42"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,8">
                                            <Grid ColumnDefinitions="1.35*,0.8*,0.55*,0.65*">
                                                <TextBlock Text="{Binding Email}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Wilayah}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Sejak}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3"
                                                        Background="{Binding StatusBackground}"
                                                        CornerRadius="15"
                                                        Padding="9,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- NOTIFICATION HISTORY -->
                    <Border
                        Background="#1C2329"
                        BorderBrush="#303A42"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="19">

                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="RIWAYAT NOTIFIKASI TERBARU"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#95A2AD"/>

                            <Grid ColumnDefinitions="0.45*,1.2*,1.65*,0.65*"
                                  Margin="0,0,0,2">
                                <TextBlock Text="WAKTU" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="1" Text="KE" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="PEMICU" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                                <TextBlock Grid.Column="3" Text="HASIL" FontSize="11" FontWeight="SemiBold" Foreground="#95A2AD" Margin="8,0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotifikasiItemViewModel">
                                        <Border BorderBrush="#303A42"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,8">
                                            <Grid ColumnDefinitions="0.45*,1.2*,1.65*,0.65*">
                                                <TextBlock Text="{Binding Waktu}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Pemicu}" FontSize="14" Foreground="#E5E9ED" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3"
                                                        Background="{Binding HasilBackground}"
                                                        CornerRadius="15"
                                                        Padding="9,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Hasil}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding HasilForeground}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Text="Satu hotspot hanya dikirim sekali per langganan. Email berbunyi “indikasi titik panas”, bukan “kebakaran”."
                                FontSize="13"
                                Foreground="#95A2AD"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>